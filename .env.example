# copiar este archivo como .env en la misma carpeta de manage.py y poner los datos de su postgres
# el .env no se sube a github, así cada una usa su contraseña sin dañarle la config a las demás
DB_NAME=sistema_erp_db
DB_USER=postgres
DB_PASSWORD=tu_contrasenia
DB_HOST=127.0.0.1
DB_PORT=5432

# correo (opcional). Si lo dejan vacio, el correo con la contraseña sale en la consola del back.
# para gmail: activar verificacion en 2 pasos y crear una "contraseña de aplicacion" en
# https://myaccount.google.com/apppasswords (no es la contraseña normal del correo)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
